# KAvach Play — environment variables
#
# For local dev: copy this file to `.env.local` and fill in real values.
# For Amplify: paste each variable into Amplify Console → App settings → Environment variables.
# For Cloud Run (legacy): APP_URL was auto-injected. On Amplify, set it explicitly.
#
# Do NOT commit .env.local. It's ignored via .gitignore.

# --- Public URL of the deployed app ---
# On Cloud Run this was auto-injected. On Amplify, set to your custom domain
# (or the amplifyapp.com URL during initial testing).
APP_URL=

# --- Razorpay ---
# Server-side (used in /api/razorpay/* route handlers)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Client-side (embedded in the browser bundle — the KEY_ID is safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Email (Resend) ---
# Resend API key (used in /api/email/send when appConfig.emailProvider = "resend").
# Server-side only. Do NOT store this in Firestore appConfig — it's publicly readable.
RESEND_API_KEY=

# --- Email (SMTP fallback) ---
# Optional: server-side SMTP password if appConfig.emailProvider = "smtp".
# Host/port/user can be set in Settings UI (public); password must be here.
SMTP_PASSWORD=
# Optional overrides (if not set, values are read from Firestore appConfig)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=

# --- WhatsApp (Meta Cloud API) ---
# Server-side only. Required if using the /api/whatsapp/* routes.
WHATSAPP_ACCESS_TOKEN=

# --- Firebase Admin (server-side SDK for /api/* routes) ---
# Full JSON of the Firebase service account, as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- API auth secrets (protect internal endpoints) ---
API_SECRET=
REPORT_API_SECRET=
