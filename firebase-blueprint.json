{
  "entities": {
    "Ground": {
      "title": "Ground",
      "description": "A cricket ground",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mapUrl": { "type": "string" },
        "organiserName": { "type": "string" },
        "gpayNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "mapUrl",
        "organiserName",
        "gpayNumber",
        "createdAt",
        "updatedAt"
      ]
    },
    "Player": {
      "title": "Player",
      "description": "A cricket player",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "inviteStatus": {
          "type": "string",
          "enum": ["Pending", "Accepted", "Invited"]
        },
        "isStudioMember": { "type": "boolean" },
        "lastPaidDate": { "type": "string" },
        "lastPaidAmount": { "type": "number" },
        "studioExpiryDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "mobile", "inviteStatus", "createdAt", "updatedAt"]
    },
    "Match": {
      "title": "Match",
      "description": "A scheduled match",
      "type": "object",
      "properties": {
        "groundId": { "type": "string" },
        "format": { "type": "string", "enum": ["T20", "T30", "Other"] },
        "jerseyColor": { "type": "string", "enum": ["Scarlet Red", "Whites"] },
        "opponent": { "type": "string" },
        "matchType": { "type": "string", "enum": ["Practice", "Tournament"] },
        "fee": { "type": "number" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "maxSquadSize": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "groundId",
        "format",
        "jerseyColor",
        "opponent",
        "matchType",
        "fee",
        "date",
        "time",
        "maxSquadSize",
        "createdAt",
        "updatedAt"
      ]
    },
    "MatchPayment": {
      "title": "MatchPayment",
      "description": "A player's payment status for a match",
      "type": "object",
      "properties": {
        "matchId": { "type": "string" },
        "playerId": { "type": "string" },
        "guestName": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Paid", "Unpaid", "Not Playing"]
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["matchId", "playerId", "status", "updatedAt"]
    },
    "Merchandise": {
      "title": "Merchandise",
      "description": "An item in the club shop",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["Jersey", "Pant", "Round Hat", "Other"] },
        "basePrice": { "type": "number" },
        "sizes": { "type": "array" },
        "specs": { "type": "array" },
        "minOrderQuantity": { "type": "number" },
        "status": { "type": "string", "enum": ["Accepting Orders", "Not Accepting Orders"] }
      },
      "required": ["name", "category", "basePrice", "minOrderQuantity", "status"]
    },
    "MerchOrder": {
      "title": "MerchOrder",
      "description": "An order placed for merchandise",
      "type": "object",
      "properties": {
        "playerId": { "type": "string" },
        "playerName": { "type": "string" },
        "merchId": { "type": "string" },
        "merchName": { "type": "string" },
        "size": { "type": "string" },
        "spec": { "type": "string" },
        "jerseyName": { "type": "string" },
        "jerseyNumber": { "type": "string" },
        "price": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Unpaid"] },
        "orderStatus": { "type": "string", "enum": ["Order Placed", "Awaiting Min Order Qnty", "Ready to Place Order", "Order Received", "Fulfilled"] }
      },
      "required": ["playerId", "playerName", "merchId", "merchName", "size", "price", "paymentStatus", "orderStatus"]
    },
    "Poll": {
      "title": "Poll",
      "description": "An opinion poll",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["singleChoice", "multipleChoice", "slider"] },
        "options": { "type": "array" },
        "sliderMin": { "type": "number" },
        "sliderMax": { "type": "number" },
        "isSticked": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "isSticked", "isActive", "createdAt", "updatedAt"]
    },
    "PollResponse": {
      "title": "PollResponse",
      "description": "A player's response to an opinion poll",
      "type": "object",
      "properties": {
        "pollId": { "type": "string" },
        "playerId": { "type": "string" },
        "response": { "type": ["string", "array", "number"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pollId", "playerId", "response", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/grounds/{groundId}": {
      "schema": "Ground",
      "description": "Cricket grounds available"
    },
    "/players/{playerId}": {
      "schema": "Player",
      "description": "Registered and invited players"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Scheduled matches"
    },
    "/matches/{matchId}/payments/{paymentId}": {
      "schema": "MatchPayment",
      "description": "Payments for a specific match"
    },
    "/merchandises/{merchId}": {
      "schema": "Merchandise",
      "description": "Items in the shop"
    },
    "/merchOrders/{orderId}": {
      "schema": "MerchOrder",
      "description": "Orders for merchandise"
    },
    "/polls/{pollId}": {
      "schema": "Poll",
      "description": "Opinion polls"
    },
    "/pollResponses/{responseId}": {
      "schema": "PollResponse",
      "description": "Responses to opinion polls"
    }
  }
}
