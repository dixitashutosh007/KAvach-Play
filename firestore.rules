rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/appUsers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data
        : {};
    }

    function isAccountActive() {
      return isSignedIn() && getUserData().get('status', 'Active') != 'Disabled';
    }

    function isSelf(playerId) {
      return isSignedIn()
        && isAccountActive()
        && (
          getUserData().get('playerId', null) == playerId ||
          (exists(/databases/$(database)/documents/players/$(playerId)) &&
           get(/databases/$(database)/documents/players/$(playerId)).data.get('disabled', false) != true &&
           (get(/databases/$(database)/documents/players/$(playerId)).data.get('authUid', null) == request.auth.uid ||
            (request.auth.uid == playerId && get(/databases/$(database)/documents/players/$(playerId)).data.get('authUid', request.auth.uid) == request.auth.uid)))
        );
    }

    function isSuperAdmin() {
      // Super-admin authority is granted strictly via the `admin: true` Firebase Auth custom claim (SEC-001)
      // and requires an active (non-disabled) account status once the appUsers document exists (Bootstrap Policy).
      return isSignedIn()
        && isAccountActive()
        && request.auth.token.get('admin', false) == true;
    }

    // D-22 role consolidation: Match Admin, Studio Admin and Designer are retired into
    // Club Admin. The retired appUsers flags (isMatchAdmin, isStudioAdmin, isDesigner,
    // canDesign) grant NOTHING; these helpers keep their names for the existing rules
    // below and now mean "Club Admin (or the Super Admin claim)".
    function isStudioAdmin() {
      return isClubAdmin();
    }

    function isMatchAdmin() {
      return isClubAdmin();
    }

    function isFinanceAdmin() {
      return isAccountActive()
        && (request.auth.token.get('admin', false) == true || getUserData().get('isFinanceAdmin', false) == true);
    }

    function isClubAdmin() {
      return isAccountActive()
        && (request.auth.token.get('admin', false) == true || getUserData().get('isClubAdmin', false) == true);
    }

    function isAnyAdmin() {
      return isAccountActive()
        && (request.auth.token.get('admin', false) == true
            || getUserData().get('isFinanceAdmin', false) == true
            || getUserData().get('isClubAdmin', false) == true);
    }

    // Role-bearing appUsers keys. Written ONLY by the server (Access Control API and the
    // role-consolidation migration, via the Admin SDK) — no client may change them,
    // Super Admin included, so every role change is validated and audited server-side.
    function roleKeys() {
      return ['role', 'isSuperAdmin', 'isClubAdmin', 'isFinanceAdmin', 'isStudioAdmin', 'isMatchAdmin',
              'isDesigner', 'canDesign', 'roleMigration', 'rolesUpdatedAt', 'rolesUpdatedBy'];
    }

    function isVerified() {
      return isAnyAdmin() || (request.auth.token.get('email_verified', false) == true) || 
        (exists(/databases/$(database)/documents/players/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/players/$(request.auth.uid)).data.inviteStatus in ['Verified', 'Accepted']);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_@\\.\\+\\s\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /outOfPlays/{docId} {
      allow read: if isSignedIn();
      allow create: if isAnyAdmin() || isSelf(incoming().playerId);
      allow update: if isAnyAdmin() || isSelf(existing().playerId);
      allow delete: if isAnyAdmin() || isSelf(existing().playerId);
    }

    match /appConfig/{docId} {
      // appConfig is read publicly (needed on the login page for club name,
      // logo, theme). Secret fields must NEVER be written here — they live
      // in server-side env vars. A write is rejected if it *changes* one
      // of the forbidden keys. Using diff().affectedKeys() rather than
      // incoming().keys() so that a stale secret already sitting in the
      // doc (from a pre-migration write) doesn't perma-block every future
      // update. Non-super-admins remain locked out by isSuperAdmin().
      allow read: if true;
      allow create: if isSuperAdmin()
        && !incoming().keys().hasAny([
          'razorpayKeySecret',
          'smtpPassword',
          'resendApiKey',
          'whatsappAccessToken'
        ]);
      allow update: if isSuperAdmin()
        && !incoming().diff(existing()).affectedKeys().hasAny([
          'razorpayKeySecret',
          'smtpPassword',
          'resendApiKey',
          'whatsappAccessToken'
        ]);
    }

    match /appUsers/{userId} {
      // R2-A: an account doc is readable by its owner; listing/reading other accounts is
      // limited to active administrators (isAnyAdmin covers the Super Admin claim).
      allow get: if isSignedIn() && (request.auth.uid == userId || isAnyAdmin());
      allow list: if isAnyAdmin();
      allow create: if !incoming().keys().hasAny(['playerId'])
        && (!('role' in incoming()) || incoming().role == 'player')
        && !incoming().keys().hasAny(roleKeys().removeAll(['role']))
        && (
          isSuperAdmin() || (
            isSignedIn()
            && request.auth.uid == userId
            && !incoming().keys().hasAny(['status'])
          )
        );
      allow update: if !incoming().diff(existing()).affectedKeys().hasAny(['playerId'])
        && !incoming().diff(existing()).affectedKeys().hasAny(roleKeys())
        && (
          isSuperAdmin() || (
            isSignedIn()
            && (request.auth.uid == userId || isClubAdmin())
            && !incoming().diff(existing()).affectedKeys().hasAny(['status'])
          )
        );
      allow delete: if isSuperAdmin();
    }

    match /phoneIndex/{phone} {
      allow read, write: if false; // Internal authoritative identity index: Server Admin SDK only
    }

    match /uidIndex/{uid} {
      allow read, write: if false; // Internal authoritative identity index: Server Admin SDK only
    }

    match /mergeJobs/{jobId} {
      allow read, write: if false; // Server Admin SDK only
    }

    function isValidGround(data) {
      return data.keys().hasAll(['name', 'mapUrl', 'organiserName', 'gpayNumber', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.mapUrl is string && data.mapUrl.size() <= 500
        && data.organiserName is string && data.organiserName.size() <= 100
        && data.gpayNumber is string && data.gpayNumber.size() <= 20
        && (!('organiserPhone' in data) || (data.organiserPhone is string && data.organiserPhone.size() <= 20))
        && (!('practiceFee' in data) || data.practiceFee is number)
        && (!('tournamentFee' in data) || data.tournamentFee is number)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['name', 'mobile', 'inviteStatus', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.mobile is string && data.mobile.size() <= 20
        && data.inviteStatus in ['Pending', 'Accepted', 'Invited', 'Unverified', 'Verified', 'Rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlayerSelfUpdate(incoming, existing) {
      return (!('name' in incoming) || (incoming.name is string && incoming.name.size() > 0 && incoming.name.size() <= 100))
        && (!('email' in incoming) || (incoming.email is string && incoming.email.size() <= 100))
        && (!('mobile' in incoming) || (incoming.mobile is string && incoming.mobile.size() <= 20))
        && (!('dob' in incoming) || (incoming.dob is string && incoming.dob.size() <= 20))
        && (!('locality' in incoming) || (incoming.locality is string && incoming.locality.size() <= 100))
        && (!('bloodGroup' in incoming) || (incoming.bloodGroup is string && incoming.bloodGroup.size() <= 10))
        && (!('emergencyContact' in incoming) || (incoming.emergencyContact is string && incoming.emergencyContact.size() <= 20))
        && (!('battingStyle' in incoming) || (incoming.battingStyle is string && incoming.battingStyle.size() <= 50))
        && (!('bowlingStyle' in incoming) || (incoming.bowlingStyle is string && incoming.bowlingStyle.size() <= 50))
        && (!('isWicketKeeper' in incoming) || incoming.isWicketKeeper is bool)
        && (!('chestSize' in incoming) || (incoming.chestSize is string && incoming.chestSize.size() <= 20))
        && (!('waistSize' in incoming) || (incoming.waistSize is string && incoming.waistSize.size() <= 20))
        && (!('jerseyNumber' in incoming) || (incoming.jerseyNumber is string && incoming.jerseyNumber.size() <= 10))
        && (!('jerseyName' in incoming) || (incoming.jerseyName is string && incoming.jerseyName.size() <= 50))
        && (!('photoURL' in incoming) || (incoming.photoURL is string && incoming.photoURL.size() <= 500))
        && (!('inviteStatus' in incoming) || incoming.inviteStatus == existing.get('inviteStatus', '') || (incoming.inviteStatus == 'Pending' && existing.get('inviteStatus', '') in ['Pending', 'Unverified', 'Invited']))
        && (!('updatedAt' in incoming) || incoming.updatedAt == request.time);
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['groundId', 'format', 'jerseyColor', 'opponent', 'matchType', 'fee', 'date', 'time', 'maxSquadSize', 'createdAt', 'updatedAt'])
        && (!data.keys().hasAny(['isArchived']) || data.isArchived is bool)
        && (!data.keys().hasAny(['matchFeeBudget']) || (data.matchFeeBudget is int || data.matchFeeBudget is float))
        && data.groundId is string && data.groundId.size() <= 128
        && data.format in ['T20', 'T30', 'Other']
        && data.jerseyColor in ['Scarlet Red', 'Whites']
        && data.opponent is string && data.opponent.size() <= 100
        && data.matchType in ['Practice', 'Tournament']
        && (data.fee is int || data.fee is float)
        && data.date is string && data.date.size() <= 50
        && data.time is string && data.time.size() <= 10
        && (data.maxSquadSize is int || data.maxSquadSize is float)
        && data.get('matchUrl', '') is string
        && data.get('streamingUrl', '') is string
        && data.get('result', 'Pending') in ['KAvach Won', 'KAvach Lost', 'Draw', 'Tie', 'Abandoned', 'Pending']
        && data.get('resultMarginType', 'runs') in ['runs', 'wickets']
        && (data.get('resultMarginAmount', 0) is int || data.get('resultMarginAmount', 0) is float)
        && data.get('playerOfTheMatch', '') is string
        && data.get('potmId', '') is string
        && (!data.keys().hasAny(['topPerformerIds']) || data.topPerformerIds is list)
        && data.get('bestBatsman', '') is string
        && data.get('bestBowler', '') is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ── Finance Plans / D4: fee fields on match payments ─────────────────────
    // Fee amounts, plan tags, sponsorship arrangements and the finance
    // snapshot are set by Finance / Super Admins (or by the server via the
    // Admin SDK: /api/finance/match-plans). Match Admins manage the squad,
    // availability and cash / bank-deposit collection at the recorded fee.
    // ── Match finance lifecycle (C1 / C2) ────────────────────────────────────
    // Server-only fields on a match: actual ground fee, finance open/closed and
    // their history (written by /api/finance/match-ledger via the Admin SDK).
    function matchFinanceServerKeys() {
      return ['groundFeePaidAmount', 'isGroundFeePaid', 'groundFeeSetBy', 'groundFeeSetByName', 'groundFeeSetAt',
              'groundFeeHistory', 'financeStatus', 'financeClosedAt', 'financeClosedBy', 'financeClosedByName',
              'financeHistory'];
    }

    function isFinanceClosedMatch(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId))
        && get(/databases/$(database)/documents/matches/$(matchId)).data.get('financeStatus', 'open') == 'closed';
    }

    // Real money held on a match payment (refunds go through the server).
    // Club-sponsored, subscription and paid-by-another-player settlements and
    // ₹0 rows are not real money.
    function isCollectedMoney(d) {
      return d.get('status', '') == 'Paid'
        && !(d.get('manualMethod', '') in ['club_sponsored', 'part_of_plan'])
        && d.get('sponsoredBy', '') == ''
        && d.get('feeCollectedAmount', d.get('feeOverride', 1)) != 0;
    }

    // Applies to every client update of a match payment, for every role.
    function paymentFinanceGuards(matchId) {
      let changed = incoming().diff(existing()).affectedKeys();
      return !changed.hasAny(['reversals', 'financeSnapshot'])
        && (!isCollectedMoney(existing())
            || !changed.hasAny(['status', 'paymentMethod', 'manualMethod', 'manualBy', 'feeCollectedAmount',
                                'razorpayPaymentId', 'feeOverride', 'feeOffsetAmount', 'planTag',
                                'sponsoredBy', 'sponsoring']))
        && (!isFinanceClosedMatch(matchId)
            || (!changed.hasAny(['feeOverride', 'feeOffsetAmount', 'planTag', 'sponsoredBy', 'sponsoring'])
                && !(existing().status == 'Not Playing' && incoming().status != 'Not Playing')
                && !(changed.hasAny(['manualMethod'])
                     && incoming().get('manualMethod', '') in ['club_sponsored', 'part_of_plan'])));
    }

    function isPlanSettled(data) {
      return data.get('manualMethod', '') in ['club_sponsored', 'part_of_plan'];
    }

    // What a Match Admin may create: a squad / availability row, no fee fields.
    function isMatchAdminPaymentCreate(data) {
      return data.keys().hasOnly(['id', 'matchId', 'playerId', 'guestName', 'status', 'availability',
                                  'tacticalNote', 'availabilityNote', 'createdAt', 'updatedAt'])
        && data.status in ['Unpaid', 'Not Playing'];
    }

    // What a Match Admin may change on an existing payment.
    function isMatchAdminPaymentUpdate(matchId) {
      let changed = incoming().diff(existing()).affectedKeys();
      return changed.hasOnly(['status', 'availability', 'tacticalNote', 'availabilityNote',
                              'paymentMethod', 'manualMethod', 'manualBy', 'feeCollectedAmount', 'updatedAt'])
        && incoming().status in ['Paid', 'Unpaid', 'Not Playing']
        // No gateway claims: Razorpay payments are confirmed by the server.
        && (!changed.hasAny(['paymentMethod']) || incoming().get('paymentMethod', 'manual') == 'manual')
        // Only real collection methods; plan / club sponsorship is a Finance decision.
        && (!changed.hasAny(['manualMethod'])
            || incoming().get('manualMethod', 'cash_collected') in ['cash_collected', 'deposited_directly'])
        // Collected amount must be the recorded fee (plan fee, else the match fee).
        && (!changed.hasAny(['feeCollectedAmount'])
            || incoming().feeCollectedAmount == existing().get('feeOverride',
                 get(/databases/$(database)/documents/matches/$(matchId)).data.fee))
        // A fee settled by a plan / club sponsorship can only be marked Not Playing.
        && (!isPlanSettled(existing()) || incoming().status == existing().status || incoming().status == 'Not Playing');
    }

    function isValidMatchPayment(data) {
      return data.keys().hasAll(['id', 'matchId', 'playerId', 'status', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.matchId is string && data.matchId.size() <= 128
        && data.playerId is string && data.playerId.size() <= 128
        && data.status in ['Paid', 'Unpaid', 'Not Playing', 'Waived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlayerStat(data) {
      return data.keys().hasAll(['playerId', 'year', 'runs', 'wickets', 'updatedAt'])
        && data.playerId is string && data.playerId.size() <= 128
        && data.year is int
        && data.runs is int
        && data.wickets is int
        && data.updatedAt is timestamp;
    }

    function isValidSubscriptionPlan(data) {
      return data.keys().hasAll(['name', 'durationDays', 'fee', 'benefits', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && (data.durationDays is int || data.durationDays is float)
        && (data.fee is int || data.fee is float)
        && data.benefits is string && data.benefits.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubscriptionHistory(data) {
      return data.keys().hasAll(['playerId', 'adminId', 'adminName', 'newExpiryDate', 'planId', 'planName', 'paidAmount', 'createdAt'])
        && data.playerId is string
        && data.adminId is string
        && data.adminName is string
        && data.newExpiryDate is string
        && (!data.keys().hasAny(['oldExpiryDate']) || data.oldExpiryDate is string)
        && data.planId is string
        && data.planName is string
        && (data.paidAmount is int || data.paidAmount is float)
        && data.createdAt is timestamp;
    }

    function isValidPoll(data) {
      return data.keys().hasAll(['title', 'type', 'isSticked', 'isActive', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 200
        && data.type in ['singleChoice', 'multipleChoice', 'slider']
        && (!data.keys().hasAny(['options']) || data.options is list)
        && (!data.keys().hasAny(['sliderMin']) || (data.sliderMin is int || data.sliderMin is float))
        && (!data.keys().hasAny(['sliderMax']) || (data.sliderMax is int || data.sliderMax is float))
        && (!data.keys().hasAny(['sliderMinLabel']) || data.sliderMinLabel is string)
        && (!data.keys().hasAny(['sliderMaxLabel']) || data.sliderMaxLabel is string)
        && (!data.keys().hasAny(['isEdited']) || data.isEdited is bool)
        && data.isSticked is bool
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPollResponse(data) {
      return data.keys().hasAll(['pollId', 'playerId', 'response', 'createdAt', 'updatedAt'])
        && data.pollId is string && data.pollId.size() <= 128
        && data.playerId is string && data.playerId.size() <= 128
        && (data.response is string || data.response is list || data.response is int || data.response is float)
        && (!data.keys().hasAny(['isArchived']) || data.isArchived is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMerchOrder(data) {
      return data.keys().hasAll(['id', 'playerId', 'playerName', 'merchId', 'merchName', 'price', 'paymentStatus', 'orderStatus', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.playerId is string && data.playerId.size() <= 128
        && data.playerName is string && data.playerName.size() <= 100
        && data.merchId is string && data.merchId.size() <= 128
        && data.merchName is string && data.merchName.size() <= 100
        && (data.price is int || data.price is float)
        && data.paymentStatus is string
        && data.orderStatus is string
        && data.createdAt is timestamp;
    }

    // R5: unmatched / rejected Razorpay payment events. Written only by the server (Admin SDK);
    // Finance and Super Admins may read them for reconciliation.
    match /webhookDeadLetters/{recordId} {
      allow read: if isFinanceAdmin() || isSuperAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update: if isAnyAdmin();
      allow delete: if isSuperAdmin();
    }

    match /paymentLinks/{linkId} {
      allow read: if true;
      allow create, update, delete: if isFinanceAdmin() || isSuperAdmin();
    }

    match /subscriptionPlans/{planId} {
      allow read: if isSignedIn();
      allow create: if isStudioAdmin()
        && isValidSubscriptionPlan(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isStudioAdmin()
        && isValidSubscriptionPlan(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if isStudioAdmin();
    }

    match /subscriptionHistory/{historyId} {
      // R2-C: membership history is readable by the member it belongs to and by active
      // administrators. Player queries must filter on their own playerId.
      allow read: if isAnyAdmin() || isSelf(resource.data.get('playerId', ''));
      allow create: if isStudioAdmin()
        && isValidSubscriptionHistory(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /feeTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isFinanceAdmin();
    }

    match /feePlans/{planId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || isFinanceAdmin();
      allow update: if isSuperAdmin() || isFinanceAdmin();
      allow delete: if isSuperAdmin() || isFinanceAdmin();
    }

    match /{path=**}/payments/{paymentId} {
      allow read: if isAnyAdmin() || (isSignedIn() && isSelf(resource.data.get('playerId', '')));
    }

    match /{path=**}/otherFees/{feeId} {
      allow read: if isFinanceAdmin() || isSuperAdmin() || (isSignedIn() && isSelf(resource.data.get('playerId', '')));
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
    }

    match /playerStats/{statId} {
      allow read: if isSignedIn();
      allow create: if isMatchAdmin()
        && isValidId(statId)
        && isValidPlayerStat(incoming())
        && exists(/databases/$(database)/documents/players/$(incoming().playerId))
        && incoming().updatedAt == request.time
        && incoming().keys().size() == 5;

      allow update: if isMatchAdmin()
        && isValidId(statId)
        && isValidPlayerStat(incoming())
        && incoming().playerId == existing().playerId
        && incoming().year == existing().year
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['runs', 'wickets', 'updatedAt']);

      allow delete: if isMatchAdmin() && isValidId(statId);
    }

    match /badgeTypes/{defId} {
      allow read: if isSignedIn();
      allow create: if isClubAdmin()
        && isValidId(defId)
        && incoming().label is string
        && incoming().short is string
        && incoming().tier is string
        && incoming().emoji is string;
      allow update: if isClubAdmin();
      allow delete: if isClubAdmin();
    }

    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow create: if isClubAdmin()
        && isValidId(badgeId)
        && incoming().playerId is string
        && incoming().badgeType is string
        && incoming().awardedBy is string
        && incoming().awardedAt == request.time
        && incoming().redeemed == false
        && exists(/databases/$(database)/documents/players/$(incoming().playerId));
      allow update: if isClubAdmin()
        && incoming().playerId == existing().playerId
        && incoming().badgeType == existing().badgeType
        && incoming().awardedBy == existing().awardedBy
        && incoming().awardedAt == existing().awardedAt;
      allow delete: if isClubAdmin();
    }

    match /catchLog/{entryId} {
      allow read: if isSignedIn();
      allow create: if isMatchAdmin() || isClubAdmin()
        && incoming().playerId is string
        && incoming().type is string
        && incoming().count is int;
      allow delete: if isClubAdmin();
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isAnyAdmin();
      allow update: if isAnyAdmin();
      allow delete: if isAnyAdmin();
    }

    match /notifications/{notifId} {
      // A user can read any notification (client filters to their own). Since
      // read is broad, keep the write surface tight: only the notification's
      // owner or an admin can modify/delete. Broadcast notifs (userId ==
      // "admin"/"all") are admin-owned by definition.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        incoming().userId == request.auth.uid ||
        isAnyAdmin() ||
        incoming().userId == "admin" ||
        incoming().userId == "all"
      );
      allow update: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAnyAdmin() ||
        (existing().userId in ["admin", "all"] && isAnyAdmin())
      );
      allow delete: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAnyAdmin()
      );
    }

    match /grounds/{groundId} {
      allow read: if true;
      allow create: if isMatchAdmin()
        && isValidId(groundId)
        && isValidGround(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isMatchAdmin()
        && isValidId(groundId)
        && isValidGround(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'mapUrl', 'organiserName', 'organiserPhone', 'gpayNumber', 'practiceFee', 'tournamentFee', 'updatedAt']);

      allow delete: if isMatchAdmin() && isValidId(groundId);
    }

    function isValidTournament(data) {
      return data.keys().hasAll(['name', 'groundId', 'organiserName', 'organiserPhone', 'gpayNumber', 'jerseyColor', 'amountPerMatch', 'perPlayerFee', 'status', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.groundId is string && data.groundId.size() <= 128
        && data.organiserName is string && data.organiserName.size() <= 100
        && data.organiserPhone is string && data.organiserPhone.size() <= 20
        && data.gpayNumber is string && data.gpayNumber.size() <= 20
        && data.jerseyColor in ['Scarlet Red', 'Whites']
        && data.get('format', 'T30') in ['T20', 'T30']
        && (data.amountPerMatch is int || data.amountPerMatch is float)
        && (data.perPlayerFee is int || data.perPlayerFee is float)
        && data.status in ['Upcoming', 'Ongoing', 'Ended', 'Disabled']
        && data.get('startDate', '') is string
        && data.get('endDate', '') is string
        && data.get('notes', '') is string
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isMatchAdmin()
        && isValidId(tournamentId)
        && isValidTournament(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isMatchAdmin()
        && isValidId(tournamentId)
        && isValidTournament(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isMatchAdmin() && isValidId(tournamentId);
    }

    match /players/{playerId} {
      allow read: if isSignedIn();
      allow create: if !incoming().keys().hasAny(['authUid', 'mergedInto', 'mergeStatus', 'mergeJobId'])
        && (isAnyAdmin() || isSelf(playerId));
      allow update: if !incoming().diff(existing()).affectedKeys().hasAny(['authUid', 'mergedInto', 'mergeStatus', 'mergeJobId'])
        && (
          isAnyAdmin()
          || (
            isSelf(playerId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'email', 'mobile', 'dob', 'locality', 'bloodGroup',
              'emergencyContact', 'battingStyle', 'bowlingStyle', 'isWicketKeeper',
              'chestSize', 'waistSize', 'jerseyNumber', 'jerseyName', 'photoURL',
              'inviteStatus', 'updatedAt'
            ])
            && isValidPlayerSelfUpdate(incoming(), existing())
          )
        );
      allow delete: if isAnyAdmin() && isValidId(playerId);

      match /otherFees/{feeId} {
        allow read: if isFinanceAdmin() || isSuperAdmin() || isSelf(playerId);
        allow create, update, delete: if isFinanceAdmin() || isSuperAdmin();
      }
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if isMatchAdmin()
        && isValidId(matchId)
        && isValidMatch(incoming())
        && !incoming().keys().hasAny(matchFinanceServerKeys())
        && exists(/databases/$(database)/documents/grounds/$(incoming().groundId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if (isMatchAdmin() || isFinanceAdmin())
        && isValidId(matchId)
        && isValidMatch(incoming())
        // C1: finance lifecycle fields are server-only.
        && !incoming().diff(existing()).affectedKeys().hasAny(matchFinanceServerKeys())
        // C1: once match finances are closed, the fee basis can't change.
        && (existing().get('financeStatus', 'open') != 'closed'
            || !incoming().diff(existing()).affectedKeys().hasAny(['fee', 'matchFeeBudget']))
        && exists(/databases/$(database)/documents/grounds/$(incoming().groundId))
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      // C1: a match whose finances are closed keeps its financial history.
      allow delete: if isMatchAdmin() && existing().get('financeStatus', 'open') != 'closed';

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && incoming().matchId == matchId
          && isSelf(incoming().playerId)
          && incoming().keys().hasAll(['id', 'matchId', 'playerId', 'playerName', 'text', 'createdAt'])
          && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 1000
          && incoming().createdAt == request.time;
        allow delete: if isMatchAdmin() || isSelf(existing().playerId);
      }

      match /payments/{paymentId} {
        allow read: if isAnyAdmin() || (isSignedIn() && (resource.data.playerId == request.auth.uid || isSelf(resource.data.playerId)));
        allow create: if (
            isFinanceAdmin() ||
            (isMatchAdmin() && isMatchAdminPaymentCreate(incoming())) ||
            (
              isSignedIn()
              && isSelf(incoming().playerId)
              && incoming().status in ['Unpaid', 'Not Playing']
              && incoming().keys().hasOnly(['id', 'matchId', 'playerId', 'status', 'availability', 'tacticalNote', 'availabilityNote', 'createdAt', 'updatedAt'])
              && (!('tacticalNote' in incoming()) || (incoming().tacticalNote is string && incoming().tacticalNote.size() <= 500))
              && (!('availabilityNote' in incoming()) || (incoming().availabilityNote is string && incoming().availabilityNote.size() <= 500))
            )
          )
          && isValidId(paymentId)
          && isValidMatchPayment(incoming())
          && incoming().matchId == matchId
          // C2: server-only fields; no new squad rows once match finances are closed.
          && !incoming().keys().hasAny(['reversals', 'financeSnapshot'])
          && !isFinanceClosedMatch(matchId)
          && exists(/databases/$(database)/documents/players/$(incoming().playerId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        // Reverted: the playerId invariant is enforced again for
        // client-side writes. Duplicate-profile merges no longer touch
        // this collection from the client — /api/admin/merge-players
        // uses the admin SDK, which bypasses these rules entirely.
        allow update: if (
            isFinanceAdmin() ||
            (isMatchAdmin() && isMatchAdminPaymentUpdate(matchId)) ||
            (
              isSignedIn()
              && isSelf(existing().playerId)
              && (incoming().status == existing().status || (incoming().status in ['Unpaid', 'Not Playing'] && existing().status in ['Unpaid', 'Not Playing']))
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'availability',
                'tacticalNote',
                'availabilityNote',
                'status',
                'updatedAt'
              ])
              && (!('tacticalNote' in incoming()) || (incoming().tacticalNote is string && incoming().tacticalNote.size() <= 500))
              && (!('availabilityNote' in incoming()) || (incoming().availabilityNote is string && incoming().availabilityNote.size() <= 500))
            )
          )
          && isValidId(paymentId)
          && isValidMatchPayment(incoming())
          // C2: collected money, reversals, snapshots and closed-match locks (all roles).
          && paymentFinanceGuards(matchId)
          && incoming().matchId == existing().matchId
          && incoming().playerId == existing().playerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;

        allow delete: if false; // Do not delete payments, mark as Not Playing
      }
    }

    match /merchandises/{merchId} {
      allow read: if isSignedIn();
      allow write: if isAnyAdmin();
    }

    // Club Shop availability: the existing appConfig/default.features.shop flag
    // (absent = enabled). A disabled Shop accepts no new player orders.
    function isShopEnabled() {
      return !exists(/databases/$(database)/documents/appConfig/default)
        || get(/databases/$(database)/documents/appConfig/default).data.get('features', {}).get('shop', true) != false;
    }

    match /merchOrders/{orderId} {
      allow read: if isAnyAdmin() || (isSignedIn() && isSelf(resource.data.playerId));
      allow create: if isSignedIn()
        && isShopEnabled()
        && isValidId(orderId)
        && isValidMerchOrder(incoming())
        && isSelf(incoming().playerId)
        && incoming().paymentStatus == 'Unpaid'
        && incoming().orderStatus == 'Order Placed'
        && incoming().createdAt == request.time;
      allow update: if isAnyAdmin() || (
        isSignedIn()
        && isSelf(existing().playerId)
        && isValidMerchOrder(incoming())
        && incoming().paymentStatus == existing().paymentStatus
        && incoming().price == existing().price
        && incoming().playerId == existing().playerId
        && incoming().createdAt == existing().createdAt
      );
      allow delete: if isAnyAdmin();
    }

    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isAnyAdmin()
        && isValidId(pollId)
        && isValidPoll(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAnyAdmin()
        && isValidId(pollId)
        && isValidPoll(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAnyAdmin();
    }

    match /pollResponses/{responseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(responseId)
        && isValidPollResponse(incoming())
        && exists(/databases/$(database)/documents/polls/$(incoming().pollId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isSelf(existing().playerId)
        && isValidId(responseId)
        && isValidPollResponse(incoming())
        && exists(/databases/$(database)/documents/polls/$(incoming().pollId))
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAnyAdmin();
    }

    match /clubLeads/{leadId} {
      allow read, write: if isAnyAdmin();
    }
  }
}
