rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(playerId) {
      return isSignedIn() && (
        request.auth.uid == playerId ||
        (exists(/databases/$(database)/documents/players/$(playerId)) && 
         get(/databases/$(database)/documents/players/$(playerId)).data.get('authUid', null) == request.auth.uid)
      );
    }

    function isSuperAdmin() {
      // Super-admin is granted via the `admin: true` Firebase Auth custom
      // claim (set with scripts/set-admin-claim.js). The appUsers.role check
      // is kept as a fallback so existing admins keep working during the
      // transition. Once every admin has the claim, drop the second branch.
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        (exists(/databases/$(database)/documents/appUsers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStudioAdmin() {
      return isSuperAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/appUsers/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.get('isStudioAdmin', false) == true);
    }

    function isMatchAdmin() {
      return isSuperAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/appUsers/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.get('isMatchAdmin', false) == true);
    }

    function isFinanceAdmin() {
      return isSuperAdmin() || (isSignedIn() &&
        exists(/databases/$(database)/documents/appUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.get('isFinanceAdmin', false) == true);
    }

    function isClubAdmin() {
      return isSuperAdmin() || (isSignedIn() &&
        exists(/databases/$(database)/documents/appUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/appUsers/$(request.auth.uid)).data.get('isClubAdmin', false) == true);
    }

    function isAnyAdmin() {
      return isSuperAdmin() || isStudioAdmin() || isMatchAdmin() || isFinanceAdmin() || isClubAdmin();
    }

    function isVerified() {
      return isAnyAdmin() || (request.auth.token.get('email_verified', false) == true) || 
        (exists(/databases/$(database)/documents/players/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/players/$(request.auth.uid)).data.inviteStatus in ['Verified', 'Accepted']);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_@\\.\\+\\s\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /outOfPlays/{docId} {
      allow read: if isSignedIn();
      allow create: if isAnyAdmin() || isSelf(incoming().playerId);
      allow update: if isAnyAdmin() || isSelf(existing().playerId);
      allow delete: if isAnyAdmin() || isSelf(existing().playerId);
    }

    match /appConfig/{docId} {
      // appConfig is read publicly (needed on the login page for club name,
      // logo, theme). Secret fields must NEVER be written here — they live
      // in server-side env vars. A write is rejected if it *changes* one
      // of the forbidden keys. Using diff().affectedKeys() rather than
      // incoming().keys() so that a stale secret already sitting in the
      // doc (from a pre-migration write) doesn't perma-block every future
      // update. Non-super-admins remain locked out by isSuperAdmin().
      allow read: if true;
      allow create: if isSuperAdmin()
        && !incoming().keys().hasAny([
          'razorpayKeySecret',
          'smtpPassword',
          'resendApiKey',
          'whatsappAccessToken'
        ]);
      allow update: if isSuperAdmin()
        && !incoming().diff(existing()).affectedKeys().hasAny([
          'razorpayKeySecret',
          'smtpPassword',
          'resendApiKey',
          'whatsappAccessToken'
        ]);
    }

    match /appUsers/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    function isValidGround(data) {
      return data.keys().hasAll(['name', 'mapUrl', 'organiserName', 'gpayNumber', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.mapUrl is string && data.mapUrl.size() <= 500
        && data.organiserName is string && data.organiserName.size() <= 100
        && data.gpayNumber is string && data.gpayNumber.size() <= 20
        && (!('organiserPhone' in data) || (data.organiserPhone is string && data.organiserPhone.size() <= 20))
        && (!('practiceFee' in data) || data.practiceFee is number)
        && (!('tournamentFee' in data) || data.tournamentFee is number)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['name', 'mobile', 'inviteStatus', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.mobile is string && data.mobile.size() <= 20
        && data.inviteStatus in ['Pending', 'Accepted', 'Invited', 'Unverified', 'Verified', 'Rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['groundId', 'format', 'jerseyColor', 'opponent', 'matchType', 'fee', 'date', 'time', 'maxSquadSize', 'createdAt', 'updatedAt'])
        && (!data.keys().hasAny(['isArchived']) || data.isArchived is bool)
        && data.groundId is string && data.groundId.size() <= 128
        && data.format in ['T20', 'T30', 'Other']
        && data.jerseyColor in ['Scarlet Red', 'Whites']
        && data.opponent is string && data.opponent.size() <= 100
        && data.matchType in ['Practice', 'Tournament']
        && (data.fee is int || data.fee is float)
        && data.date is string && data.date.size() <= 50
        && data.time is string && data.time.size() <= 10
        && (data.maxSquadSize is int || data.maxSquadSize is float)
        && data.get('matchUrl', '') is string
        && data.get('streamingUrl', '') is string
        && data.get('result', 'Pending') in ['KAvach Won', 'KAvach Lost', 'Draw', 'Tie', 'Abandoned', 'Pending']
        && data.get('resultMarginType', 'runs') in ['runs', 'wickets']
        && (data.get('resultMarginAmount', 0) is int || data.get('resultMarginAmount', 0) is float)
        && data.get('playerOfTheMatch', '') is string
        && data.get('potmId', '') is string
        && (!data.keys().hasAny(['topPerformerIds']) || data.topPerformerIds is list)
        && data.get('bestBatsman', '') is string
        && data.get('bestBowler', '') is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMatchPayment(data) {
      return data.keys().hasAll(['id', 'matchId', 'playerId', 'status', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.matchId is string && data.matchId.size() <= 128
        && data.playerId is string && data.playerId.size() <= 128
        && data.status in ['Paid', 'Unpaid', 'Not Playing']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlayerStat(data) {
      return data.keys().hasAll(['playerId', 'year', 'runs', 'wickets', 'updatedAt'])
        && data.playerId is string && data.playerId.size() <= 128
        && data.year is int
        && data.runs is int
        && data.wickets is int
        && data.updatedAt is timestamp;
    }

    function isValidSubscriptionPlan(data) {
      return data.keys().hasAll(['name', 'durationDays', 'fee', 'benefits', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && (data.durationDays is int || data.durationDays is float)
        && (data.fee is int || data.fee is float)
        && data.benefits is string && data.benefits.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubscriptionHistory(data) {
      return data.keys().hasAll(['playerId', 'adminId', 'adminName', 'newExpiryDate', 'planId', 'planName', 'paidAmount', 'createdAt'])
        && data.playerId is string
        && data.adminId is string
        && data.adminName is string
        && data.newExpiryDate is string
        && (!data.keys().hasAny(['oldExpiryDate']) || data.oldExpiryDate is string)
        && data.planId is string
        && data.planName is string
        && (data.paidAmount is int || data.paidAmount is float)
        && data.createdAt is timestamp;
    }

    function isValidPoll(data) {
      return data.keys().hasAll(['title', 'type', 'isSticked', 'isActive', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 200
        && data.type in ['singleChoice', 'multipleChoice', 'slider']
        && (!data.keys().hasAny(['options']) || data.options is list)
        && (!data.keys().hasAny(['sliderMin']) || (data.sliderMin is int || data.sliderMin is float))
        && (!data.keys().hasAny(['sliderMax']) || (data.sliderMax is int || data.sliderMax is float))
        && (!data.keys().hasAny(['sliderMinLabel']) || data.sliderMinLabel is string)
        && (!data.keys().hasAny(['sliderMaxLabel']) || data.sliderMaxLabel is string)
        && (!data.keys().hasAny(['isEdited']) || data.isEdited is bool)
        && data.isSticked is bool
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPollResponse(data) {
      return data.keys().hasAll(['pollId', 'playerId', 'response', 'createdAt', 'updatedAt'])
        && data.pollId is string && data.pollId.size() <= 128
        && data.playerId is string && data.playerId.size() <= 128
        && (data.response is string || data.response is list || data.response is int || data.response is float)
        && (!data.keys().hasAny(['isArchived']) || data.isArchived is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update: if isAnyAdmin();
      allow delete: if isSuperAdmin();
    }

    match /paymentLinks/{linkId} {
      allow read: if true;
      allow create: if isAnyAdmin();
      allow update: if isSignedIn();
    }

    match /subscriptionPlans/{planId} {
      allow read: if isSignedIn();
      allow create: if isStudioAdmin()
        && isValidSubscriptionPlan(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isStudioAdmin()
        && isValidSubscriptionPlan(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if isStudioAdmin();
    }

    match /subscriptionHistory/{historyId} {
      allow read: if isSignedIn();
      allow create: if isStudioAdmin()
        && isValidSubscriptionHistory(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /feeTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isFinanceAdmin();
    }

    match /feePlans/{planId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || isFinanceAdmin();
      allow update: if isSuperAdmin() || isFinanceAdmin();
      allow delete: if isSuperAdmin() || isFinanceAdmin();
    }

    match /{path=**}/payments/{paymentId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/otherFees/{feeId} {
      allow read: if isSignedIn();
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
    }

    match /playerStats/{statId} {
      allow read: if isSignedIn();
      allow create: if isMatchAdmin()
        && isValidId(statId)
        && isValidPlayerStat(incoming())
        && exists(/databases/$(database)/documents/players/$(incoming().playerId))
        && incoming().updatedAt == request.time
        && incoming().keys().size() == 5;

      allow update: if isMatchAdmin()
        && isValidId(statId)
        && isValidPlayerStat(incoming())
        && incoming().playerId == existing().playerId
        && incoming().year == existing().year
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['runs', 'wickets', 'updatedAt']);

      allow delete: if isMatchAdmin() && isValidId(statId);
    }

    match /badgeTypes/{defId} {
      allow read: if isSignedIn();
      allow create: if isClubAdmin()
        && isValidId(defId)
        && incoming().label is string
        && incoming().short is string
        && incoming().tier is string
        && incoming().emoji is string;
      allow update: if isClubAdmin();
      allow delete: if isClubAdmin();
    }

    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow create: if isClubAdmin()
        && isValidId(badgeId)
        && incoming().playerId is string
        && incoming().badgeType is string
        && incoming().awardedBy is string
        && incoming().awardedAt == request.time
        && incoming().redeemed == false
        && exists(/databases/$(database)/documents/players/$(incoming().playerId));
      allow update: if isClubAdmin()
        && incoming().playerId == existing().playerId
        && incoming().badgeType == existing().badgeType
        && incoming().awardedBy == existing().awardedBy
        && incoming().awardedAt == existing().awardedAt;
      allow delete: if isClubAdmin();
    }

    match /catchLog/{entryId} {
      allow read: if isSignedIn();
      allow create: if isMatchAdmin() || isClubAdmin()
        && incoming().playerId is string
        && incoming().type is string
        && incoming().count is int;
      allow delete: if isClubAdmin();
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isAnyAdmin();
      allow update: if isSignedIn();
      allow delete: if isAnyAdmin();
    }

    match /notifications/{notifId} {
      // A user can read any notification (client filters to their own). Since
      // read is broad, keep the write surface tight: only the notification's
      // owner or an admin can modify/delete. Broadcast notifs (userId ==
      // "admin"/"all") are admin-owned by definition.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        incoming().userId == request.auth.uid ||
        isAnyAdmin() ||
        incoming().userId == "admin" ||
        incoming().userId == "all"
      );
      allow update: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAnyAdmin() ||
        (existing().userId in ["admin", "all"] && isAnyAdmin())
      );
      allow delete: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAnyAdmin()
      );
    }

    match /grounds/{groundId} {
      allow read: if true;
      allow create: if isMatchAdmin()
        && isValidId(groundId)
        && isValidGround(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isMatchAdmin()
        && isValidId(groundId)
        && isValidGround(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'mapUrl', 'organiserName', 'organiserPhone', 'gpayNumber', 'practiceFee', 'tournamentFee', 'updatedAt']);

      allow delete: if isMatchAdmin() && isValidId(groundId);
    }

    function isValidTournament(data) {
      return data.keys().hasAll(['name', 'groundId', 'organiserName', 'organiserPhone', 'gpayNumber', 'jerseyColor', 'amountPerMatch', 'perPlayerFee', 'status', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.groundId is string && data.groundId.size() <= 128
        && data.organiserName is string && data.organiserName.size() <= 100
        && data.organiserPhone is string && data.organiserPhone.size() <= 20
        && data.gpayNumber is string && data.gpayNumber.size() <= 20
        && data.jerseyColor in ['Scarlet Red', 'Whites']
        && data.get('format', 'T30') in ['T20', 'T30']
        && (data.amountPerMatch is int || data.amountPerMatch is float)
        && (data.perPlayerFee is int || data.perPlayerFee is float)
        && data.status in ['Upcoming', 'Ongoing', 'Ended', 'Disabled']
        && data.get('startDate', '') is string
        && data.get('endDate', '') is string
        && data.get('notes', '') is string
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isMatchAdmin()
        && isValidId(tournamentId)
        && isValidTournament(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isMatchAdmin()
        && isValidId(tournamentId)
        && isValidTournament(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isMatchAdmin() && isValidId(tournamentId);
    }

    match /players/{playerId} {
      allow read: if isSignedIn();
      allow create: if isAnyAdmin() || isSelf(playerId);
      allow update: if isAnyAdmin() || isSelf(playerId) ||
        (isSignedIn() && existing().get('authUid', null) == null && incoming().get('authUid', null) == request.auth.uid && request.auth.token.phone_number != null && existing().get('mobile', '') != null && (request.auth.token.phone_number.matches('.*' + existing().mobile + '.*') || existing().mobile.matches('.*' + request.auth.token.phone_number.replace('\\+', '') + '.*')));
      allow delete: if isAnyAdmin() && isValidId(playerId);

      match /otherFees/{feeId} {
        allow read: if isSignedIn();
        allow create, delete: if isAnyAdmin() || isSelf(playerId);
        allow update: if isAnyAdmin() || isSelf(playerId) || (isSignedIn() && incoming().status == 'Paid');
      }
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if isMatchAdmin()
        && isValidId(matchId)
        && isValidMatch(incoming())
        && exists(/databases/$(database)/documents/grounds/$(incoming().groundId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isMatchAdmin()
        && isValidId(matchId)
        && isValidMatch(incoming())
        && exists(/databases/$(database)/documents/grounds/$(incoming().groundId))
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isMatchAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && incoming().matchId == matchId
          && isSelf(incoming().playerId)
          && incoming().keys().hasAll(['id', 'matchId', 'playerId', 'playerName', 'text', 'createdAt'])
          && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 1000
          && incoming().createdAt == request.time;
        allow delete: if isMatchAdmin() || isSelf(existing().playerId);
      }

      match /payments/{paymentId} {
        allow read: if isSignedIn();
        allow create: if (isMatchAdmin() || isFinanceAdmin() || (isSignedIn() && isSelf(incoming().playerId) && incoming().status == 'Not Playing'))
          && isValidId(paymentId)
          && isValidMatchPayment(incoming())
          && incoming().matchId == matchId
          && exists(/databases/$(database)/documents/players/$(incoming().playerId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        // Reverted: the playerId invariant is enforced again for
        // client-side writes. Duplicate-profile merges no longer touch
        // this collection from the client — /api/admin/merge-players
        // uses the admin SDK, which bypasses these rules entirely.
        allow update: if (isMatchAdmin() || isFinanceAdmin() || (isSignedIn() && isSelf(existing().playerId)) || (isSignedIn() && incoming().status == 'Paid'))
          && isValidId(paymentId)
          && isValidMatchPayment(incoming())
          && incoming().matchId == existing().matchId
          && incoming().playerId == existing().playerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;

        allow delete: if false; // Do not delete payments, mark as Not Playing
      }
    }

    match /merchandises/{merchId} {
      allow read: if isSignedIn();
      allow write: if isAnyAdmin();
    }

    match /merchOrders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAnyAdmin() || (isSignedIn() && (existing().playerId == request.auth.uid || isSelf(existing().playerId)));
      allow delete: if isAnyAdmin();
    }

    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isAnyAdmin()
        && isValidId(pollId)
        && isValidPoll(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAnyAdmin()
        && isValidId(pollId)
        && isValidPoll(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAnyAdmin();
    }

    match /pollResponses/{responseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(responseId)
        && isValidPollResponse(incoming())
        && exists(/databases/$(database)/documents/polls/$(incoming().pollId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isSelf(existing().playerId)
        && isValidId(responseId)
        && isValidPollResponse(incoming())
        && exists(/databases/$(database)/documents/polls/$(incoming().pollId))
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAnyAdmin();
    }

    match /clubLeads/{leadId} {
      allow read, write: if isAnyAdmin();
    }
  }
}
